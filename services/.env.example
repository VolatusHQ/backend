# Volatus backend services. Copy to services/.env.local and fill in.
# .env.local is gitignored by the root .gitignore; .env.example is not.

UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# The only privileged key. It can publish a payoff for coverage on Arc, and
# nothing else: it cannot touch vault collateral, cannot change what
# VAR-LONG/VAR-SHORT redeem for, and cannot stop a subscriber recovering
# unspent premium (DECISIONS.md §12). Secret store, never a repo, never a log.
REPORTER_PRIVATE_KEY=
REPORTER_ADDRESS=

# Unprivileged. Only ever calls the permissionless sync(). Needs USDC on Arc
# for gas -- on Arc, gas IS USDC.
KEEPER_PRIVATE_KEY=
KEEPER_ADDRESS=

# Phase 6 agents
PRIVY_APP_ID=
PRIVY_APP_SECRET=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
